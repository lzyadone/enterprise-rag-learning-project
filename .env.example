# Copy this file to .env locally if you use a dotenv loader.
# Do not commit real API keys.

DEEPSEEK_API_KEY=your_deepseek_api_key_here
RAG_DEFAULT_LLM_PROVIDER=ollama
RAG_DEFAULT_RETRIEVAL_MODE=direct

# Optional multilingual cross-encoder reranker.
RAG_RERANKER_BACKEND=transformers
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANKER_DEVICE=auto
RAG_RERANKER_BATCH_SIZE=2
RAG_RERANKER_MAX_LENGTH=512
RAG_EXCLUSIVE_MODEL_RESIDENCY=1
